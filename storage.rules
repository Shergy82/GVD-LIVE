rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Site documents (PDF / Excel), up to 30MB each. Matches the app's open access model.
    match /site_files/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource == null || request.resource.size < 30 * 1024 * 1024;
    }
  }
}
