{
  "functions": {
    "source": "functions",
    "codebase": "live"
  },
  "hosting": {
    "site": "gvd-live",
    "public": "public",
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/@(jspdf.umd.min.js|jspdf.plugin.autotable.min.js|pdf.min.js|pdf.worker.min.js|qrcode.min.js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|svg|ico|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/!(jspdf.umd.min|jspdf.plugin.autotable.min|pdf.min|pdf.worker.min|qrcode.min).@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/files/**",
        "function": {
          "functionId": "siteFile",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "hosting": {
      "port": 5000
    }
  }
}
